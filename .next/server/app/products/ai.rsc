11:["$","div",null,{"className":"Footer-module__hP-FLq__bottom","children":[["$","p",null,{"className":"Footer-module__hP-FLq__copyright","children":"Copyright © 2020 上海比升互联网技术有限公司 All Rights Reserved"}],["$","div",null,{"className":"Footer-module__hP-FLq__icpInfo","children":[["$","a",null,{"href":"https://beian.miit.gov.cn/","target":"_blank","rel":"noopener noreferrer","className":"Footer-module__hP-FLq__icpLink","children":"沪ICP备18023095号-1"}],["$","span",null,{"className":"Footer-module__hP-FLq__divider","children":"|"}],["$","span",null,{"children":"备案号：31011202008526"}]]}]]}]
